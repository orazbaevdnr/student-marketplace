# Database (use docker-compose.yml to start PostgreSQL, or use -Dspring-boot.run.profiles=dev for H2)
DB_URL=jdbc:postgresql://localhost:5432/marketplace
DB_USER=marketplace
DB_PASSWORD=marketplace
DB_POOL_SIZE=10

# JWT (must be at least 32 chars — change this in production!)
JWT_SECRET=dev-local-secret-change-in-production-!!
JWT_TTL_MINUTES=60

# Email domain restriction (leave empty to allow all emails, set to kbtu.kz for production)
ALLOWED_EMAIL_DOMAIN=

# Admin account (created on startup)
ADMIN_EMAIL=admin@kbtu.kz
ADMIN_PASSWORD=Admin12345!

# Login/register attempts per client IP per minute (in-memory, per backend instance)
AUTH_RATE_LIMIT_PER_MINUTE=20

# Photo storage directory
PHOTO_DIR=./data/photos

# CORS allowed origins for the frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
