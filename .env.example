# Frontend configuration. Copy to .env and fill in:
#   Copy-Item .env.example .env

# --- Local development against the Spring Boot backend ---------------------
VITE_USE_MOCK=false
VITE_ENABLE_DEMO_LOGIN=false
VITE_API_BASE_URL=http://localhost:8080/api/client

# --- Fully offline demo (no backend, no Firebase) --------------------------
# VITE_USE_MOCK=true
# VITE_ENABLE_DEMO_LOGIN=true

# --- Firebase web app ------------------------------------------------------
# Firebase console -> Project settings -> Your apps -> Web app.
# These values are public; they are inlined into the bundle at build time.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=student-marketplace-1b107.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=student-marketplace-1b107
VITE_FIREBASE_APP_ID=

# --- Build base path -------------------------------------------------------
# GitHub Pages needs /student-marketplace/ (default).
# A server that hosts the app at the domain root needs /.
# VITE_BASE_PATH=/
