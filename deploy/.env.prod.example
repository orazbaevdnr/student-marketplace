# Copy this file to .env.prod and fill in every value.
# NEVER commit .env.prod (it is in .gitignore).
# Values must not contain "$" (Docker Compose would treat it as a variable); use $$ to escape.
#
# Docker Compose does not read .env.prod automatically, so every command passes
#   --env-file .env.prod -f docker-compose.prod.yml
# (see DEPLOYMENT.md).
#
#   Copy-Item .env.prod.example .env.prod
#   # generate strong values for the secrets:
#   .\scripts\generate-secrets.ps1
#   notepad .env.prod

# ---------- public entry point ----------
# The domain users open in the browser (used in docs and CORS).
DOMAIN=marketplace.kbtu.kz
HTTP_PORT=80
HTTPS_PORT=443

# ---------- database ----------
DB_NAME=marketplace
DB_USER=marketplace
# openssl rand -base64 32
DB_PASSWORD=change-me-long-random-password

# ---------- backend ----------
# At least 32 characters. The backend refuses to start with a weak/empty secret.
# openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_TTL_MINUTES=60

# First administrator, created on the first start if it does not exist.
ADMIN_EMAIL=admin@kbtu.kz
ADMIN_PASSWORD=change-me-strong-admin-password

# Only this e-mail domain can register. Empty = any domain (do not do this in production).
ALLOWED_EMAIL_DOMAIN=kbtu.kz

# Firebase project used to verify the frontend's ID tokens. Empty = Firebase login is off.
FIREBASE_PROJECT_ID=student-marketplace-1b107

# Browsers only need CORS when the frontend and API are on different origins.
# In this stack both are served by the same Nginx, so this is only a safety net.
CORS_ORIGINS=https://marketplace.kbtu.kz

# ---------- frontend (inlined by Vite at build time) ----------
# These are public Firebase web-app values, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=student-marketplace-1b107.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=student-marketplace-1b107
VITE_FIREBASE_APP_ID=

# ---------- backups ----------
BACKUP_KEEP_DAYS=14
